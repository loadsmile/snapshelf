{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_SUPPORT_EMAIL": "codecrafting.ltd@gmail.com",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://snapshelf-legal.vercel.app/privacy/",
        "EXPO_PUBLIC_SUPPORT_URL": "https://snapshelf-legal.vercel.app/"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      },
      "ios": {}
    }
  }
}
